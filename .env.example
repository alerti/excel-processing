# Database Configuration
DB_URL=jdbc:postgresql://db:5432/your_database_name
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password
DB_DDL_AUTO=update
DB_NAME=your_database_name
DB_PORT=5432

# Application Configuration
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Logging Configuration
LOG_LEVEL=INFO

# Note: Replace the following placeholders with your actual values:
# - your_database_name: The name of your PostgreSQL database
# - your_database_username: Your PostgreSQL username
# - your_database_password: Your PostgreSQL password
